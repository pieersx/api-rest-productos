@baseUrl = http://localhost:3000
@pedidoId = 1

### Caso 1: Crear pedido válido (debe calcular total correctamente)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "cliente": "Juan Pérez",
  "detalles": [
    { "producto": "Laptop", "cantidad": 1, "precio_unitario": 3500.50 },
    { "producto": "Mouse", "cantidad": 2, "precio_unitario": 50.00 }
  ]
}

### Caso 2: Pedido sin detalles (debe fallar 400)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "cliente": "Ana López",
  "detalles": []
}

### Caso 3: Cantidad inválida (debe fallar 400)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "cliente": "Carlos Díaz",
  "detalles": [
    { "producto": "Teclado", "cantidad": 0, "precio_unitario": 120.00 }
  ]
}

### Caso 4: Cambiar estado (debe actualizar correctamente)
PUT {{baseUrl}}/pedidos/{{pedidoId}}
Content-Type: application/json

{
  "estado": "confirmado"
}

### Caso 5: Eliminar pedido confirmado (debe fallar 400)
DELETE {{baseUrl}}/pedidos/{{pedidoId}}

### Listar pedidos
GET {{baseUrl}}/pedidos

### Obtener pedido por ID
GET {{baseUrl}}/pedidos/{{pedidoId}}
